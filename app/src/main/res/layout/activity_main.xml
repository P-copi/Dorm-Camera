<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Dorm Camera • พร้อมใช้งาน"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:background="#000000" />

    <TextView
        android:id="@+id/folderBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="โฟลเดอร์บันทึก: หลัก • แตะเพื่อเปลี่ยนด่วน"
        android:textColor="#FFF59D"
        android:textSize="17sp"
        android:textStyle="bold"
        android:background="#1B1B1B"
        android:clickable="true"
        android:focusable="true" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <TextView
        android:id="@+id/zoomText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="5dp"
        android:text="ซูม 1.0x • แตะภาพเพื่อโฟกัส • บีบนิ้วเพื่อซูม"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="#111111" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp"
        android:background="#111111">

        <Button
            android:id="@+id/exposureDownButton"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="− แสง" />

        <Button
            android:id="@+id/exposureResetButton"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="EV 0.0" />

        <Button
            android:id="@+id/exposureUpButton"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:text="+ แสง" />

        <Button
            android:id="@+id/flashButton"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1.2"
            android:layout_marginStart="3dp"
            android:text="แฟลช Auto" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:background="#111111">

        <Button
            android:id="@+id/folderButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="จัดการโฟลเดอร์" />

        <Button
            android:id="@+id/explorerButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Explorer" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:background="#111111">

        <Button
            android:id="@+id/switchButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="0.9"
            android:layout_marginEnd="5dp"
            android:text="สลับกล้อง" />

        <Button
            android:id="@+id/captureButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.05"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:text="ถ่ายภาพ" />

        <Button
            android:id="@+id/videoButton"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.05"
            android:layout_marginStart="5dp"
            android:text="วิดีโอ" />
    </LinearLayout>
</LinearLayout>
