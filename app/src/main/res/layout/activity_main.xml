<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050506"
    android:paddingTop="2dp">

    <com.pcopi.dormcamera.PressFeedbackButton
        android:id="@+id/folderBanner"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="2dp"
        android:minHeight="0dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="📁  หลัก   ›"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_folder_banner"
        android:backgroundTint="@null"
        android:stateListAnimator="@null" />

    <com.pcopi.dormcamera.CameraStatusTextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:gravity="center"
        android:minWidth="190dp"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:text="กล้องหลัง  •  GPS กำลังตรวจสอบ"
        android:textColor="#E6E6EA"
        android:textSize="10sp"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_status_chip" />

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_preview_frame"
        android:clipToOutline="true">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <com.pcopi.dormcamera.GridOverlayView
            android:id="@+id/gridOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/focusIndicator"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:visibility="gone"
            android:background="@drawable/bg_focus_ring" />

        <com.pcopi.dormcamera.PulseChronometer
            android:id="@+id/recordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:format="●  REC  %s"
            android:textColor="#FF6D78"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="5dp"
            android:visibility="gone"
            android:background="@drawable/bg_recording_badge" />

        <TextView
            android:id="@+id/warningBanner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="104dp"
            android:gravity="center"
            android:maxWidth="330dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="พื้นที่จัดเก็บเหลือน้อย"
            android:textColor="#FFF1D2"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:elevation="8dp"
            android:visibility="gone"
            android:background="@drawable/bg_warning_banner" />

        <TextView
            android:id="@+id/saveBanner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="56dp"
            android:gravity="center"
            android:maxWidth="310dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="✓  บันทึกภาพแล้ว"
            android:textColor="#EFFFF4"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:elevation="7dp"
            android:visibility="gone"
            android:background="@drawable/bg_save_banner" />

        <LinearLayout
            android:id="@+id/latestMediaPanel"
            android:layout_width="80dp"
            android:layout_height="94dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.pcopi.dormcamera.LatestMediaView
                android:id="@+id/latestMediaView"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="2dp"
                android:clipToOutline="true"
                android:elevation="7dp"
                android:background="@drawable/bg_thumbnail_frame" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="ล่าสุด"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:background="@drawable/bg_info_chip" />
        </LinearLayout>

        <TextView
            android:id="@+id/zoomText"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="1.0×  •  แตะโฟกัส  •  บีบซูม"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:background="@drawable/bg_info_chip" />

        <!-- One compact side handle remains visible while advanced tools are folded. -->
        <com.pcopi.dormcamera.PressFeedbackButton
            android:id="@+id/cameraToolsTab"
            android:layout_width="62dp"
            android:layout_height="68dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="116dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:gravity="center"
            android:padding="2dp"
            android:text="☷&#10;เครื่องมือ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:contentDescription="เปิดเครื่องมือปรับแสง ซูม และตั้งค่ากล้อง"
            android:elevation="9dp"
            android:background="@drawable/bg_control_teal"
            android:backgroundTint="@null"
            android:stateListAnimator="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="7dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="11dp"
        android:background="@drawable/bg_control_panel">

        <!-- The shutter/video row stays visible. Tool rows collapse as one block. -->
        <LinearLayout
            android:id="@+id/advancedCameraControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/exposureDownButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="− แสง"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_control_azure"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.CameraStateButton
                android:id="@+id/exposureResetButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="EV 0.0"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_control_violet"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/exposureUpButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+ แสง"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_control_amber"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.CameraStateButton
                android:id="@+id/flashButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="⚡ Auto"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_control_teal"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/sliderToggleButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="🎚 แสง / ซูม  ▾"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:contentDescription="เปิดหรือปิดแถบเลื่อนปรับแสงและซูม"
                android:background="@drawable/bg_control_teal"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/nightLightsButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="0dp"
                android:text="🌙 แสงสีไฟ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:contentDescription="ตั้งแสงสำหรับรักษาสีของไฟยามค่ำคืน"
                android:background="@drawable/bg_control_night"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cameraSlidersPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/bg_control_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☀️ ความสว่าง EV"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/exposureSliderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EV 0.0"
                    android:textColor="#FFD18A"
                    android:textSize="13sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/exposureSeekBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:max="100"
                android:progress="50"
                android:progressTint="#FFBC53"
                android:thumbTint="#FFBC53"
                android:contentDescription="เลื่อนเพื่อปรับค่าชดเชยแสงของกล้อง" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔎 ระดับซูม"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/zoomSliderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0×"
                    android:textColor="#69E2D6"
                    android:textSize="13sp" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/zoomSeekBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#27C7B1"
                android:thumbTint="#27C7B1"
                android:contentDescription="เลื่อนเพื่อซูมภาพด้วยกล้อง" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/folderButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="จัดการห้อง"
                android:textAllCaps="false"
                android:textColor="#EDEDF2"
                android:textSize="12sp"
                android:background="@drawable/bg_control_violet"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/explorerButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:minHeight="0dp"
                android:text="Explorer"
                android:textAllCaps="false"
                android:textColor="#EDEDF2"
                android:textSize="12sp"
                android:background="@drawable/bg_control_azure"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/shutterSoundButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="🔊"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:contentDescription="ปิดเสียงชัตเตอร์"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <com.pcopi.dormcamera.GridToggleButton
                android:id="@+id/gridButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="▦"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:contentDescription="เปิดเส้นกริด"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/switchButton"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:contentDescription="สลับกล้อง"
                android:elevation="5dp"
                android:background="@drawable/bg_button_switch"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <Space android:layout_width="18dp" android:layout_height="1dp" />

            <com.pcopi.dormcamera.SafeCaptureButton
                android:id="@+id/captureButton"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                android:contentDescription="ถ่ายภาพ"
                android:elevation="9dp"
                android:background="@drawable/bg_button_photo"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <!-- Reserved space avoids shutter movement when recording starts.
                 Pause/resume never finalizes the current MP4. -->
            <com.pcopi.dormcamera.PressFeedbackButton
                android:id="@+id/videoPauseButton"
                android:layout_width="58dp"
                android:layout_height="62dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Ⅱ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:contentDescription="หยุดบันทึกวิดีโอชั่วคราว"
                android:elevation="5dp"
                android:visibility="invisible"
                android:enabled="false"
                android:background="@drawable/bg_button_dark"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />

            <Space android:layout_width="7dp" android:layout_height="1dp" />

            <com.pcopi.dormcamera.VideoControlButton
                android:id="@+id/videoButton"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="●"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:contentDescription="เริ่มบันทึกวิดีโอ"
                android:elevation="5dp"
                android:background="@drawable/bg_button_video"
                android:backgroundTint="@null"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
