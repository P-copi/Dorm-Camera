<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050506"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/previewTitle"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="Preview"
        android:textColor="#F5F6FA"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/previewStatus"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text="กำลังเปิดไฟล์..."
        android:textColor="#AEB3BE"
        android:textSize="10.5sp" />

    <FrameLayout
        android:id="@+id/previewMediaFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:foregroundGravity="center"
        android:background="#000000">

        <com.pcopi.dormcamera.ZoomImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <VideoView
            android:id="@+id/previewVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:keepScreenOn="true"
            android:visibility="gone" />
    </FrameLayout>

    <com.pcopi.dormcamera.PressFeedbackButton
        android:id="@+id/previewPlayPauseButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        android:minHeight="0dp"
        android:text="เล่น / หยุด"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_preview_primary"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:visibility="gone" />

    <com.pcopi.dormcamera.PressFeedbackButton
        android:id="@+id/previewCloseButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="10dp"
        android:minHeight="0dp"
        android:text="กลับ EXPLORER"
        android:textAllCaps="false"
        android:textColor="#F4F5F8"
        android:textSize="15sp"
        android:background="@drawable/bg_preview_secondary"
        android:backgroundTint="@null"
        android:stateListAnimator="@null" />
</LinearLayout>
