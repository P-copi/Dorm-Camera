<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#101010" android:endColor="#050506" />
            <stroke android:width="1dp" android:color="#D6A84C" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <bitmap android:src="@drawable/brand_icon" android:gravity="fill" />
    </item>
</layer-list>
