<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#182033" />
            <stroke android:width="1dp" android:color="#26324B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="90" android:startColor="#2E4E86" android:endColor="#1F2E52" />
            <stroke android:width="1dp" android:color="#6EA0FF" />
        </shape>
    </item>
</selector>
