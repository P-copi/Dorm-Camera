<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#1B2434" />
            <stroke android:width="1dp" android:color="#26354D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient android:angle="0" android:startColor="#2E6BFF" android:endColor="#4D84FF" />
            <stroke android:width="1dp" android:color="#78A2FF" />
        </shape>
    </item>
</selector>
