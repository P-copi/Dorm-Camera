<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#12000000" />
            <stroke android:width="1dp" android:color="#2FFFFFFF" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#16000000" />
            <stroke android:width="3dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <gradient android:angle="90" android:startColor="#FFFFFFFF" android:endColor="#FFE9EAEE" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
